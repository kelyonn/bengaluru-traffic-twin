# Raw OSM extracts (re-download from Geofabrik)
*.osm.pbf
*.osm.xml
southern-zone-latest.osm.pbf

# SUMO network & routes (regenerated by netconvert / duarouter)
*.net.xml
*.rou.xml
*.rou.alt.xml
bengaluru.trips.xml
*.weights.src.xml
*.weights.dst.xml

# Simulation outputs (multi-GB, regenerated by sumo)
edgedata.out.xml
fcd.out.xml

# Derived dashboard data (regenerated by build scripts)
congestion.geojson
roads.geojson
roads_light.geojson
roads_path.json
trips.json
trips_light.json
intervals/

# Analytics (regenerated by build_analytics.py)
analytics_daily.json
analytics_areas.json
analytics_speed_dist.json
analytics_peaks.json

# MQTT logs (regenerated by build_mqtt_log.py)
mqtt_logs/mqtt_log.jsonl
mqtt_logs/by_type/

# Logs
*.log
.DS_Store
